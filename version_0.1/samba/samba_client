============== Kerberos ==============
$ sudo nano /etc/krb5.conf 
    
[libdefaults]
    default_realm 	= 	PIONUX.KOOMPI.LOCAL 
	clockskew 	= 	300
	ticket_lifetime	=	1d
    forwardable     =       true
    proxiable       =       true
    dns_lookup_realm =      true
    dns_lookup_kdc  =       true
    allow_weak_crypto =     true
[realms]
	PIONUX.KOOMPI.LOCAL = {
		kdc 	= 	PIONUX.KOOMPI.LOCAL
        admin_server = PIONUX.KOOMPI.LOCAL
		default_domain = PIONUX.KOOMPI.LOCAL
	}
[domain_realm]
    .kerberos.server = PIONUX.KOOMPI.LOCAL
	.pionux.koompi.local = PIONUX.KOOMPI.LOCAL
	pionux.koompi.local = PIONUX.KOOMPI.LOCAL
[appdefaults]
	pam = {
	ticket_lifetime 	= 1d
	renew_lifetime 		= 1d
	forwardable 		= true
	proxiable 		= false
	retain_after_close 	= false
	minimum_uid 		= 0
	debug 			= false
	}
[logging]
	default 		= FILE:/var/log/krb5libs.log
	kdc 			= FILE:/var/log/kdc.log
    admin_server            = FILE:/var/log/kadmind.log
#save

+ Creating a Kerberos ticket
    $ kinit administrator@PIONUX.KOOMPI.LOCAL
    $ klist 
    
+ pam_winbind.conf
$ sudo nano /etc/security/pam_winbind.conf
[global]
    debug = no
    debug_state = no
    try_first_pass = yes
    krb5_auth = yes
    krb5_ccache_type = FILE
    cached_login = yes
    silent = no
    mkhomedir = yes

============== Samba ==============
$ sudo nano /etc/samba/smb.conf
[Global]
    netbios name = MYARCHLINUX
    workgroup = KOOMPI
    realm =  PIONUX.KOOMPI.LOCAL
    server string = %h ArchLinux Host
    security = ads
    encrypt passwords = yes
    password server = pionux.koompi.local
    client signing = auto
    server signing = auto

    idmap config * : backend = tdb
    idmap config * : range = 10000-20000

    winbind use default domain = Yes
    winbind enum users = Yes
    winbind enum groups = Yes
    winbind nested groups = Yes
    winbind separator = +
    winbind refresh tickets = yes
    winbind offline logon = yes
    winbind cache time = 300

    template shell = /bin/bash
    template homedir = /home/%D/%U
        
    preferred master = no
    dns proxy = no
    wins server = pionux.koompi.local 
    wins proxy = no

    inherit acls = Yes
    map acl inherit = Yes
    acl group control = yes

    load printers = no
    debug level = 3
    use sendfile = no
#save 

+ Join the domain
# net join ads -U Administrator    

