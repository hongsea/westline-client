#!/bin/bash

FILE=/etc/samba/smb.conf
if [[ -f $FILE ]];then

echo "[Global]" > $FILE
echo "netbios name = $(hostname)" >> $FILE
cat /opt/pionux/westline-client/version_0.1/samba/smb.conf >> $FILE
else
  sudo touch $FILE
  echo "[Global]" > $FILE
  echo "netbios name = $(hostname)" >> $FILE
  cat /opt/pionux/westline-client/version_0.1/samba/smb.conf >> $FILE
fi